df_long <- df %>%
pivot_longer(cols = c(fn_dia, fn_mes, estado),
names_to = "variable",
values_to = "value")
# For numeric variables, keep as numeric; for state, convert to factor
df_long <- df_long %>%
# Plot
ggplot(df_long, aes(x = value)) +
geom_bar(data = subset(df_long, variable == "state"), fill = "steelblue") +
geom_histogram(data = subset(df_long, variable %in% c("day_of_birth","month_of_birth")),
aes(y = ..density..),
bins = 31, fill = "orange", alpha = 0.5) +
facet_wrap(~variable, scales = "free_x") +
theme_minimal() +
labs(title = "Distributions of State, Day of Birth, and Month of Birth",
x = NULL, y = "Count / Density")
