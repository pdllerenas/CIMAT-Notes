set.seed(123)  # for reproducibility
n <- 100
b <- rbinom(n, 1, 0.5)         # simulate 100 games (0 or 1)
cs <- data.frame(
game = 1:n,
outcome = b,
cumulative = cumsum(b)       # cumulative wins
)
# Plot cumulative wins over games
ggplot(cs, aes(x = game, y = cumulative)) +
geom_line(color = "steelblue", size = 1) +
geom_point(aes(y = outcome + cumsum(b) - b), alpha = 0.3) +  # optional individual points
theme_minimal() +
labs(title = "Cumulative Wins Over 100 Games",
x = "Game Number",
y = "Cumulative Wins")
# Plot cumulative wins over games
ggplot(cs, aes(x = game, y = cumulative)) +
geom_line(color = "steelblue", size = 1) +
geom_point(aes(y = outcome + cumsum(b) - b), alpha = 0.3) +
theme_minimal() +
labs(title = "Cumulative Wins",
x = "Game Number",
y = "Cumulative Wins")
